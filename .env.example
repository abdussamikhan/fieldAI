# FieldAI Environment Configuration
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key-optional-fallback

# Database: PostgreSQL (Render) or local SQLite fallback
DATABASE_URL=postgresql://fieldai_user:password@localhost:5432/fieldai_db
# For lightweight local development without PostgreSQL running:
# DATABASE_URL=sqlite:///fieldai.db

# Initial Admin Credentials (seeded on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin123

# Port for local Streamlit dev
PORT=8501
